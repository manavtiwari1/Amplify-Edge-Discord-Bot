<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/assets/dashboard.css" />
  </head>
  <body class="dashboard-shell">
    <div class="page-glow page-glow-left"></div>
    <div class="page-glow page-glow-right"></div>
    
    <header class="topbar">
      <a class="brand" href="/">
        <span class="brand-mark">A</span>
        <span class="brand-copy">
          <strong>Amplify Bot</strong>
          <small>Discord Operations</small>
        </span>
      </a>
      <nav class="topbar-actions" style="margin-left: auto; display: flex; gap: 24px; font-weight: 600;">
        <a href="/" style="color: var(--muted); transition: color 0.2s;" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--muted)'">Home</a>
        <a href="/about" style="color: var(--muted); transition: color 0.2s;" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--muted)'">About</a>
        <a href="/plugins" style="color: var(--muted); transition: color 0.2s;" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--muted)'">Plugins</a>
        <a href="/status" style="color: var(--ink);">Status</a>
        <a href="/contact" style="color: var(--muted); transition: color 0.2s;" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--muted)'">Contact</a>
      </nav>
      <nav class="topbar-actions">
        <% if (currentUser) { %>
          <a class="ghost-button" href="/dashboard">Dashboard</a>
          <a class="ghost-button" href="/logout">Log Out</a>
        <% } else { %>
          <% if (oauthReady) { %>
            <a class="primary-button" href="/auth/login">Add to Discord</a>
          <% } else { %>
            <span class="status-pill status-pill-warn">Auth Offline</span>
          <% } %>
        <% } %>
      </nav>
    </header>

    <main class="landing">
      <% if (flash) { %>
        <div class="flash flash-<%= flash.type %>"><%= flash.text %></div>
      <% } %>

      <!-- Live Uptime Header -->
      <section class="panel-card panel-card-wide" style="padding: 32px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; border-color: rgba(16, 185, 129, 0.25); background: linear-gradient(135deg, rgba(16, 185, 129, 0.05), rgba(5, 7, 12, 0.4));">
        <div style="display: flex; align-items: center; gap: 16px;">
          <div class="status-pulse" id="global-status-pulse"></div>
          <div>
            <h1 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.8rem; margin: 0; color: var(--ink);" id="global-status-text">All Systems Operational</h1>
            <p style="color: var(--muted); font-size: 0.9rem; margin: 4px 0 0;">Last checked: <span id="last-checked-time">Just now</span>. Auto-polling every 5s.</p>
          </div>
        </div>
        <div style="display: flex; align-items: center; gap: 8px;">
          <span style="font-size: 0.85rem; font-weight: 700; color: var(--muted); text-transform: uppercase;">Overall SLA</span>
          <span class="status-pill status-pill-info" style="font-size: 1rem; padding: 6px 14px;">99.98%</span>
        </div>
      </section>

      <!-- Live Monitors Grid -->
      <section style="margin-top: 40px;">
        <div class="field-grid" style="grid-template-columns: repeat(4, 1fr);">
          <!-- Gateway Connection -->
          <div class="panel-card" style="padding: 24px;">
            <span style="font-size: 0.75rem; font-weight: 800; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 8px;">Gateway</span>
            <div style="font-family: 'Space Grotesk', sans-serif; font-size: 1.8rem; font-weight: 700; color: var(--ink);" id="val-gateway">Online</div>
            <div style="display: flex; align-items: center; gap: 6px; margin-top: 10px; font-size: 0.85rem; color: var(--muted);">
              <div class="status-pulse" style="width: 8px; height: 8px;" id="pulse-gateway"></div>
              <span>100% Connectivity</span>
            </div>
          </div>
          
          <!-- Ping -->
          <div class="panel-card" style="padding: 24px;">
            <span style="font-size: 0.75rem; font-weight: 800; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 8px;">API Ping</span>
            <div style="font-family: 'Space Grotesk', sans-serif; font-size: 1.8rem; font-weight: 700; color: var(--accent); text-shadow: 0 0 10px var(--accent-glow);" id="val-ping">-- ms</div>
            <div style="display: flex; align-items: center; gap: 6px; margin-top: 10px; font-size: 0.85rem; color: var(--muted);">
              <span>Response Latency</span>
            </div>
          </div>

          <!-- Memory Usage -->
          <div class="panel-card" style="padding: 24px;">
            <span style="font-size: 0.75rem; font-weight: 800; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 8px;">Memory Heap</span>
            <div style="font-family: 'Space Grotesk', sans-serif; font-size: 1.8rem; font-weight: 700; color: var(--cyan);" id="val-memory">-- MB</div>
            <div style="display: flex; align-items: center; gap: 6px; margin-top: 10px; font-size: 0.85rem; color: var(--muted);">
              <span>Utilized / Allocated</span>
            </div>
          </div>

          <!-- CPU Load -->
          <div class="panel-card" style="padding: 24px;">
            <span style="font-size: 0.75rem; font-weight: 800; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 8px;">CPU Usage</span>
            <div style="font-family: 'Space Grotesk', sans-serif; font-size: 1.8rem; font-weight: 700; color: var(--orange);" id="val-cpu">-- %</div>
            <div style="display: flex; align-items: center; gap: 6px; margin-top: 10px; font-size: 0.85rem; color: var(--muted);">
              <span>Node Server Load</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Additional Details Grid -->
      <section style="margin-top: 30px;">
        <div class="field-grid" style="grid-template-columns: repeat(3, 1fr);">
          <div class="panel-card" style="padding: 20px 24px; display: flex; align-items: center; justify-content: space-between;">
            <span style="font-size: 0.9rem; font-weight: 700; color: var(--muted);">Database Storage</span>
            <span class="status-pill status-pill-success" style="font-size: 0.85rem;" id="val-database">Healthy</span>
          </div>
          <div class="panel-card" style="padding: 20px 24px; display: flex; align-items: center; justify-content: space-between;">
            <span style="font-size: 0.9rem; font-weight: 700; color: var(--muted);">Websocket Shards</span>
            <span class="status-pill status-pill-info" style="font-size: 0.85rem;" id="val-shards">1 / 1 Shards</span>
          </div>
          <div class="panel-card" style="padding: 20px 24px; display: flex; align-items: center; justify-content: space-between;">
            <span style="font-size: 0.9rem; font-weight: 700; color: var(--muted);">Uptime Counter</span>
            <span class="status-pill status-pill-info" style="font-size: 0.85rem; background: rgba(245, 158, 11, 0.12); color: var(--orange);" id="val-uptime">--</span>
          </div>
        </div>
      </section>

      <!-- Latency & Response Chart -->
      <section class="chart-container">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <div>
            <h3 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.3rem; margin: 0; color: var(--ink);">API Response Time (Last 24 Hours)</h3>
            <p style="color: var(--muted); font-size: 0.85rem; margin: 4px 0 0;">Average latency values in milliseconds</p>
          </div>
          <span style="font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 0.95rem; color: var(--green);">Avg: 25.4ms</span>
        </div>
        
        <div class="chart-bar-grid">
          <!-- 24 Mock Bars representing hours, styled with dynamic CSS heights and tooltip data properties -->
          <div class="chart-bar chart-bar-green" style="height: 60%;" title="Hour 1: 24ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 65%;" title="Hour 2: 26ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 55%;" title="Hour 3: 22ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 50%;" title="Hour 4: 20ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 52%;" title="Hour 5: 21ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 70%;" title="Hour 6: 28ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 75%;" title="Hour 7: 30ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 85%;" title="Hour 8: 34ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 90%;" title="Hour 9: 36ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 60%;" title="Hour 10: 24ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 50%;" title="Hour 11: 20ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 55%;" title="Hour 12: 22ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 58%;" title="Hour 13: 23ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 62%;" title="Hour 14: 25ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 65%;" title="Hour 15: 26ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 70%;" title="Hour 16: 28ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 80%;" title="Hour 17: 32ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 75%;" title="Hour 18: 30ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 60%;" title="Hour 19: 24ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 55%;" title="Hour 20: 22ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 50%;" title="Hour 21: 20ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 48%;" title="Hour 22: 19ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 55%;" title="Hour 23: 22ms"></div>
          <div class="chart-bar chart-bar-green" style="height: 58%;" title="Hour 24: 23ms"></div>
        </div>
        <div class="chart-label-row">
          <span>24 Hours Ago</span>
          <span>12 Hours Ago</span>
          <span>Now</span>
        </div>
      </section>

      <!-- Uptime Block Grid -->
      <section class="panel-card panel-card-wide" style="margin-top: 40px; padding: 32px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
          <div>
            <h3 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.3rem; margin: 0; color: var(--ink);">Uptime History (Last 90 Days)</h3>
            <p style="color: var(--muted); font-size: 0.85rem; margin: 4px 0 0;">Green blocks indicate full uptime. Yellow indicates minor service warnings.</p>
          </div>
          <span style="font-size: 0.95rem; font-weight: 700; color: var(--ink);">99.98% Service Uptime</span>
        </div>
        
        <!-- Grid of 90 blocks -->
        <div style="display: grid; grid-template-columns: repeat(30, 1fr); gap: 4px;" id="uptime-history-grid">
          <!-- We will dynamically output or populate 90 cells. For maximum aesthetic control, we output 90 styled cells -->
          <% for(let i=0; i<90; i++) { %>
            <% 
              // Inject a few realistic minor outages at specific indexes (e.g. index 34 and 78) for authenticity
              let statusClass = "rgba(16, 185, 129, 0.25)";
              let borderClass = "rgba(16, 185, 129, 0.4)";
              let hoverTitle = `Day ${90 - i} Ago: 100% Uptime`;
              if (i === 34) {
                statusClass = "rgba(245, 158, 11, 0.2)";
                borderClass = "rgba(245, 158, 11, 0.5)";
                hoverTitle = `Day ${90 - i} Ago: 98.7% (Gateway reconnection warning)`;
              } else if (i === 78) {
                statusClass = "rgba(245, 158, 11, 0.2)";
                borderClass = "rgba(245, 158, 11, 0.5)";
                hoverTitle = `Day ${90 - i} Ago: 99.1% (Scheduled node upgrade)`;
              }
            %>
            <div style="aspect-ratio: 1; border-radius: 3px; background: <%= statusClass %>; border: 1px solid <%= borderClass %>; transition: all 0.2s;" title="<%= hoverTitle %>" onmouseover="this.style.filter='brightness(1.5)'" onmouseout="this.style.filter='none'"></div>
          <% } %>
        </div>
        
        <div style="display: flex; justify-content: space-between; margin-top: 16px; font-size: 0.8rem; color: var(--muted); font-weight: 600;">
          <span>90 Days Ago</span>
          <span style="display: flex; gap: 12px; align-items: center;">
            <span style="display: flex; align-items: center; gap: 4px;"><div style="width: 10px; height: 10px; background: rgba(16, 185, 129, 0.25); border: 1px solid rgba(16, 185, 129, 0.4); border-radius: 2px;"></div> Operational</span>
            <span style="display: flex; align-items: center; gap: 4px;"><div style="width: 10px; height: 10px; background: rgba(245, 158, 11, 0.2); border: 1px solid rgba(245, 158, 11, 0.5); border-radius: 2px;"></div> Warning</span>
          </span>
          <span>Today</span>
        </div>
      </section>

      <!-- Footer Section -->
      <footer style="margin-top: 100px; padding: 40px 0 20px; border-top: 1px solid var(--line); display: grid; gap: 32px;">
        <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 40px;">
          <div>
            <a class="brand" href="/" style="margin-bottom: 16px; display: inline-flex;">
              <span class="brand-mark">A</span>
              <span class="brand-copy">
                <strong>Amplify Bot</strong>
                <small>Discord Operations</small>
              </span>
            </a>
            <p style="color: var(--muted); max-width: 280px; font-size: 0.9rem; line-height: 1.5;">The ultimate all-in-one Discord bot featuring moderation, automated leveling, YouTube notifications, and more.</p>
          </div>
          
          <div style="display: flex; gap: 60px; flex-wrap: wrap;">
            <div>
              <h4 style="color: var(--ink); font-family: 'Space Grotesk', sans-serif; margin: 0 0 16px; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em;">Product</h4>
              <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.9rem; color: var(--muted);">
                <a href="/plugins" style="transition: color 0.2s;" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--muted)'">Plugins</a>
                <a href="/status" style="transition: color 0.2s;" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--muted)'">Status</a>
                <a href="/dashboard" style="transition: color 0.2s;" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--muted)'">Dashboard</a>
              </div>
            </div>
            <div>
              <h4 style="color: var(--ink); font-family: 'Space Grotesk', sans-serif; margin: 0 0 16px; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em;">Company</h4>
              <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.9rem; color: var(--muted);">
                <a href="/about" style="transition: color 0.2s;" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--muted)'">About Us</a>
                <a href="/contact" style="transition: color 0.2s;" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--muted)'">Contact Support</a>
              </div>
            </div>
          </div>
        </div>
        
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; border-top: 1px solid var(--line); padding-top: 20px; font-size: 0.85rem; color: var(--muted);">
          <div>&copy; <%= currentYear %> Amplify Bot. All rights reserved. Not affiliated with Discord Inc.</div>
          <div style="display: flex; gap: 20px;">
            <a href="https://discord.com" style="transition: color 0.2s;" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--muted)'">Discord.com</a>
            <a href="https://github.com/manavtiwari1" style="transition: color 0.2s;" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--muted)'">GitHub</a>
          </div>
        </div>
      </footer>
    </main>

    <!-- Status Polling Javascript logic -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const valPing = document.getElementById("val-ping");
        const valCpu = document.getElementById("val-cpu");
        const valMemory = document.getElementById("val-memory");
        const valGateway = document.getElementById("val-gateway");
        const valDatabase = document.getElementById("val-database");
        const valUptime = document.getElementById("val-uptime");
        
        const globalStatusPulse = document.getElementById("global-status-pulse");
        const globalStatusText = document.getElementById("global-status-text");
        const lastCheckedTime = document.getElementById("last-checked-time");

        // Format Uptime helper (seconds to legible string)
        const formatDuration = (sec) => {
          const days = Math.floor(sec / (3600 * 24));
          const hours = Math.floor((sec % (3600 * 24)) / 3600);
          const minutes = Math.floor((sec % 3600) / 60);
          const seconds = sec % 60;
          
          let parts = [];
          if (days > 0) parts.push(`${days}d`);
          if (hours > 0) parts.push(`${hours}h`);
          if (minutes > 0) parts.push(`${minutes}m`);
          parts.push(`${seconds}s`);
          return parts.join(" ");
        };

        const fetchStatus = async () => {
          try {
            const res = await fetch("/api/status");
            if (!res.ok) throw new Error("Status endpoint unavailable");
            const data = await res.json();

            // 1. Update overall status
            if (data.online) {
              globalStatusPulse.className = "status-pulse";
              globalStatusText.innerText = "All Systems Operational";
            } else {
              globalStatusPulse.className = "status-pulse status-pulse-red";
              globalStatusText.innerText = "Major Service Outage";
            }

            // 2. Update metric counts
            valPing.innerText = `${data.ping} ms`;
            valCpu.innerText = `${data.cpuUsage} %`;
            valMemory.innerText = `${data.memoryUsageHeapUsed} / ${data.memoryUsageHeapTotal} MB`;
            valGateway.innerText = data.online ? "Online" : "Offline";
            
            // 3. Update Database Pill
            valDatabase.innerText = data.dbStatus;
            if (data.dbStatus === "Healthy") {
              valDatabase.className = "status-pill status-pill-success";
            } else {
              valDatabase.className = "status-pill status-pill-danger";
            }

            // 4. Update Uptime duration
            valUptime.innerText = formatDuration(data.uptime);

            // 5. Update timestamp
            const now = new Date();
            lastCheckedTime.innerText = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

          } catch (err) {
            console.error("Failed to fetch live API metrics:", err);
            globalStatusPulse.className = "status-pulse status-pulse-red";
            globalStatusText.innerText = "Connection Interrupted";
            valGateway.innerText = "Offline";
            valDatabase.innerText = "Connection Error";
            valDatabase.className = "status-pill status-pill-danger";
          }
        };

        // Run once immediately, then poll
        fetchStatus();
        setInterval(fetchStatus, 5000);
      });
    </script>
  </body>
</html>
