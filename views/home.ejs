<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/assets/dashboard.css" />
  </head>
  <body class="dashboard-shell">
    <div class="page-glow page-glow-left"></div>
    <div class="page-glow page-glow-right"></div>
    <header class="topbar">
      <a class="brand" href="/">
        <span class="brand-mark">A</span>
        <span class="brand-copy">
          <strong>Amplify Edge</strong>
          <small>Discord Operations</small>
        </span>
      </a>
      <nav class="topbar-actions">
        <% if (currentUser) { %>
          <a class="ghost-button" href="/dashboard">Dashboard</a>
          <a class="ghost-button" href="/logout">Log Out</a>
        <% } else { %>
          <a class="ghost-button" href="#features">Features</a>
          <% if (oauthReady) { %>
            <a class="primary-button" href="/auth/login">Sign In With Discord</a>
          <% } else { %>
            <span class="status-pill status-pill-warn">Dashboard auth needs `DISCORD_CLIENT_SECRET`</span>
          <% } %>
        <% } %>
      </nav>
    </header>

    <main class="landing">
      <% if (flash) { %>
        <div class="flash flash-<%= flash.type %>"><%= flash.text %></div>
      <% } %>

      <% if (locals.botUnconfigured) { %>
        <div class="flash flash-error" style="border-left: 4px solid #faa61a;">
          <strong>Configuration Warning:</strong> The bot is currently unconfigured because required environment variables are missing (e.g., <code>DISCORD_BOT_TOKEN</code> or <code>DISCORD_CLIENT_ID</code>). Please add these variables in your Render environment settings.
        </div>
      <% } else if (locals.botStartupError) { %>
        <div class="flash flash-error" style="border-left: 4px solid #ed4245;">
          <strong>Bot Connection Error:</strong> The Discord bot failed to log in. Error: <code><%= botStartupError %></code>. Please check your <code>DISCORD_BOT_TOKEN</code> in your environment variables.
        </div>
      <% } %>

      <section class="hero-card">
        <div class="hero-copy">
          <span class="eyebrow"><%= hero.eyebrow %></span>
          <h1><%= hero.title %></h1>
          <p><%= hero.copy %></p>
          <div class="cta-row">
            <% if (currentUser) { %>
              <a class="primary-button" href="/dashboard">Open Your Servers</a>
            <% } else if (oauthReady) { %>
              <a class="primary-button" href="/auth/login">Connect Discord</a>
            <% } %>
            <a class="ghost-button" href="#features">See What You Can Control</a>
          </div>
        </div>
        <div class="hero-mockup-wrapper">
          <div class="mockup-container">
            <div class="mockup-header">
              <div class="mockup-dot mockup-dot-red"></div>
              <div class="mockup-dot mockup-dot-yellow"></div>
              <div class="mockup-dot mockup-dot-green"></div>
              <span style="font-size: 0.75rem; color: var(--muted); margin-left: auto;">amplify-edge.io/preview</span>
            </div>
            
            <div class="mockup-row">
              <div class="mockup-icon">🤖</div>
              <div class="mockup-text">
                <div style="font-size: 0.8rem; font-weight: 700; color: var(--muted); letter-spacing: 0.05em; text-transform: uppercase;">Bot Status</div>
                <div style="font-size: 1.05rem; font-weight: 700; margin-top: 2px;">
                  <% if (botReady) { %>
                    Online
                  <% } else if (locals.botUnconfigured) { %>
                    Unconfigured
                  <% } else if (locals.botStartupError) { %>
                    Offline (Error)
                  <% } else { %>
                    Starting
                  <% } %>
                </div>
              </div>
              <% if (botReady) { %>
                <span class="mockup-badge">ONLINE</span>
              <% } else if (locals.botUnconfigured) { %>
                <span class="mockup-badge" style="background: rgba(245, 158, 11, 0.12); color: var(--orange);">WARNING</span>
              <% } else { %>
                <span class="mockup-badge" style="background: rgba(239, 68, 68, 0.12); color: var(--red);">OFFLINE</span>
              <% } %>
            </div>

            <div class="mockup-row">
              <div class="mockup-icon mockup-icon-cyan">🌐</div>
              <div class="mockup-text">
                <div style="font-size: 0.8rem; font-weight: 700; color: var(--muted); letter-spacing: 0.05em; text-transform: uppercase;">Active Servers</div>
                <div style="font-size: 1.05rem; font-weight: 700; margin-top: 2px;"><%= stats.guildCount %> Guilds</div>
              </div>
              <span class="mockup-badge" style="background: rgba(6, 182, 212, 0.12); color: var(--cyan);">CONNECTED</span>
            </div>

            <div class="mockup-row">
              <div class="mockup-icon mockup-icon-gold">👥</div>
              <div class="mockup-text">
                <div style="font-size: 0.8rem; font-weight: 700; color: var(--muted); letter-spacing: 0.05em; text-transform: uppercase;">Total Users</div>
                <div style="font-size: 1.05rem; font-weight: 700; margin-top: 2px;"><%= stats.memberCount %> Members</div>
              </div>
              <span class="mockup-badge" style="background: rgba(245, 158, 11, 0.12); color: var(--orange);">MONITORED</span>
            </div>
          </div>
        </div>
      </section>

      <section id="features" class="feature-grid">
        <article class="feature-card">
          <span class="feature-kicker">Moderation</span>
          <h2>Handle warnings, timeouts, kicks, bans, and role actions from the browser.</h2>
        </article>
        <article class="feature-card">
          <span class="feature-kicker">Configuration</span>
          <h2>Update welcome channels, automod thresholds, blocked words, and leveling settings.</h2>
        </article>
        <article class="feature-card">
          <span class="feature-kicker">Announcements</span>
          <h2>Attach YouTube live alerts to announcement channels with optional role pings.</h2>
        </article>
      </section>
    </main>
  </body>
</html>
